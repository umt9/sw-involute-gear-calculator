<Window x:Class="GearCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGear Studio" Height="850" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5" Background="#121212" BorderBrush="#333" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#888" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3498DB" />
                    <Setter TargetName="Arrow" Property="Fill" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,8,30,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E1E1E" BorderThickness="1" BorderBrush="#333" CornerRadius="5" Margin="0,2,0,0"/>
                                    <ScrollViewer Margin="0,4,0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#121212" CornerRadius="15" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ProGear Studio v2.0" Foreground="#888" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="—" Width="30" Height="30" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnMinimize_Click"/>
                    <Button Content="☐" Width="30" Height="30" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="15" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblMainTitle" Grid.Column="0" Text="GEAR GENERATOR" Foreground="#3498DB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbLanguage" Grid.Column="1" SelectedIndex="0" Width="80" SelectionChanged="cmbLanguage_SelectionChanged" Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">
                                    <ComboBoxItem Content="🇬🇧 EN"/>
                                    <ComboBoxItem Content="🇹🇷 TR"/>
                                </ComboBox>
                            </Grid>

                            <TextBlock x:Name="lblGearType" Text="Gear Type Selection" Foreground="#B3B3B3" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <ComboBox x:Name="cmbGearType" SelectedIndex="0" SelectionChanged="cmbGearType_SelectionChanged" Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">
                                <ComboBoxItem x:Name="cbiGearSpur" Content="Spur Gear"/>
                                <ComboBoxItem x:Name="cbiGearHelical" Content="Helical Gear"/>
                                <ComboBoxItem x:Name="cbiGearInternal" Content="Internal Gear"/>
                                <ComboBoxItem x:Name="cbiGearBevel" Content="Bevel Gear"/>
                            </ComboBox>

                            <Separator Margin="0,20" Background="#333"/>

                            <TextBlock x:Name="lblBasicParams" Text="BASIC PARAMETERS" Foreground="#3498DB" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock x:Name="lblModule" Text="Module" Foreground="#888" FontSize="11"/>
                                    <TextBox x:Name="txtModule" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <TextBlock x:Name="lblTeeth" Text="Teeth Count" Foreground="#888" FontSize="11"/>
                                    <TextBox x:Name="txtTeeth" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel x:Name="panelHelix" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="lblHelixAngle" Text="Helix Angle (β)°" Foreground="#888" FontSize="11"/>
                                <TextBox x:Name="txtHelixAngle" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                            </StackPanel>

                            <TextBlock x:Name="lblWidth" Text="Face Width (B) mm" Foreground="#888" FontSize="11" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtWidth" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>

                            <Separator Margin="0,20" Background="#333"/>

                            <StackPanel x:Name="panelPipe" Visibility="Collapsed">
                                <TextBlock x:Name="lblPipeDetails" Text="EXTERNAL PIPE DETAILS" Foreground="#3498DB" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="lblPipeDia" Text="Pipe Outer Diameter (Ø)" Foreground="#888" FontSize="11"/>
                                <TextBox x:Name="txtPipeDia" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel x:Name="panelShaft">
                                <TextBlock x:Name="lblShaftDetails" Text="SHAFT &amp; KEYWAY DETAILS" Foreground="#3498DB" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="lblBore" Text="Bore Diameter (Ø)" Foreground="#888" FontSize="11"/>
                                <TextBox x:Name="txtBore" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>

                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock x:Name="lblKeyWidth" Text="Keyway Width" Foreground="#888" FontSize="11"/>
                                        <TextBox x:Name="txtKeyWidth" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock x:Name="lblKeyDepth" Text="Keyway Depth" Foreground="#888" FontSize="11"/>
                                        <TextBox x:Name="txtKeyDepth" Margin="0,5" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidationTextBox" KeyDown="TextBox_KeyDown"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <Grid Margin="0,30,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnGenerate" Grid.Column="0" Content="GENERATE &amp; DRAW" Click="btnGenerate_Click"
                                        Background="#3498DB" Foreground="White" FontWeight="Bold" Height="50" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="btnClear" Grid.Column="1" Content="✕" Click="btnClear_Click" Width="50" Height="50" Margin="10,0,0,0"
                                        Background="#E74C3C" Foreground="White" FontWeight="Bold" Cursor="Hand" ToolTip="Clear All">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="280"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="15" BorderBrush="#333" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="GearCanvas" Background="Transparent">
                            <TextBlock x:Name="lblPreview" Text="LIVE PREVIEW" Foreground="#333" FontSize="36" FontWeight="Bold" Canvas.Left="200" Canvas.Top="250" Opacity="0.5"/>
                        </Canvas>
                    </Border>

                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="15" Margin="0,20,0,0" Padding="15" BorderBrush="#333" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtTechData" Background="Transparent" Foreground="#2ECC71" FontFamily="Consolas" FontSize="14" BorderThickness="0" IsReadOnly="True" Text="--- CALCULATION RESULTS ---"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>